source_code_directory=src
mutator_type=CUSTOM
custom_mutation_spec=OperatorMutations.txt
compile_command=
test_command=python3 -m pytest ./tests/TestAdd.py ./tests/TestAlgorithms.py ./tests/TestLogicAndTypes.py
coverage_command=python3 -m trace --count --coverdir=coverage --module pytest ./tests/TestAdd.py ./tests/TestAlgorithms.py ./tests/TestLogicAndTypes.py
coverage_report=coverage
mutation_strategy=AST
