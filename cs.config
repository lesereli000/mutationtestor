source_code_directory=src/CSProject
mutator_type=AOR_PLUS_TO_MINUS
compile_command=dotnet build tests/CSProject.Tests/CSProject.Tests.csproj
test_command=dotnet test tests/CSProject.Tests/CSProject.Tests.csproj
coverage_command=dotnet test tests/CSProject.Tests/CSProject.Tests.csproj --collect:"XPlat Code Coverage" --results-directory TestResults
coverage_report=TestResults/coverage.cobertura.xml
