# Run from the repository root:
#   java -jar target/MutationTester-1.0-SNAPSHOT-jar-with-dependencies.jar external/RacketProject configs/external/racket.config
source_code_directory=rackunit-lib/rackunit
custom_mutation_spec=specs/OperatorMutations.spec
compile_command=
test_command=PLTCOLLECTS=$PWD/rackunit-lib:$PWD/testing-util-lib:$PLTCOLLECTS racket -e '(require rackunit/text-ui "rackunit-test/tests/rackunit/all-rackunit-tests.rkt") (exit (run-tests all-rackunit-tests))'
