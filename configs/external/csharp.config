# Run from the repository root:
#   java -jar target/MutationTester-1.0-SNAPSHOT-jar-with-dependencies.jar external/CSharpProject configs/external/csharp.config
source_code_directory=src/Clean.Architecture.Core
custom_mutation_spec=specs/StatementMutation.spec
compile_command=dotnet build tests/Clean.Architecture.UnitTests/Clean.Architecture.UnitTests.csproj
test_command=dotnet test tests/Clean.Architecture.UnitTests/Clean.Architecture.UnitTests.csproj
coverage_command=dotnet test tests/Clean.Architecture.UnitTests/Clean.Architecture.UnitTests.csproj --collect:"XPlat Code Coverage" --results-directory TestResults
coverage_report=TestResults/coverage.cobertura.xml
