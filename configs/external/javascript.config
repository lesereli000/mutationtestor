# Run from the repository root:
#   java -jar target/MutationTester-1.0-SNAPSHOT-jar-with-dependencies.jar external/JavaScriptProject configs/external/javascript.config
source_code_directory=lib
custom_mutation_spec=specs/OperatorMutations.spec
compile_command=
test_command=node node_modules/mocha/bin/mocha.js --require test/support/env --reporter spec --check-leaks test/ test/acceptance/ --grep '^Route|^Router'
