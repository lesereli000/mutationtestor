# Run from the repository root:
#   java -jar target/MutationTester-1.0-SNAPSHOT-jar-with-dependencies.jar samples/RacketProject configs/samples/racket-context.config
source_code_directory=project/src
custom_mutation_spec=specs/context-sensitive-mutations.spec
compile_command=
test_command=racket ./project/tests/racket-project.rkt
coverage_command=racket ./racket-line-coverage.rkt project/src project/tests/racket-project.rkt racket-coverage.info
coverage_report=racket-coverage.info
