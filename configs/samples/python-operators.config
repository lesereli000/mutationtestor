# Run from the repository root:
#   java -jar target/MutationTester-1.0-SNAPSHOT-jar-with-dependencies.jar samples/PytestProject configs/samples/python-operators.config
source_code_directory=src
custom_mutation_spec=specs/OperatorMutations.spec
compile_command=
test_command=python3 -m pytest ./tests/TestAdd.py ./tests/TestAlgorithms.py ./tests/TestLogicAndTypes.py ./tests/TestNoCoverage.py ./tests/TestStatementMutation.py ./tests/TestKilledSurvived.py
coverage_command=python3 -m trace --count --coverdir=coverage --module pytest ./tests/TestAdd.py ./tests/TestAlgorithms.py ./tests/TestLogicAndTypes.py ./tests/TestNoCoverage.py ./tests/TestStatementMutation.py ./tests/TestKilledSurvived.py
coverage_report=coverage
