# Run from the repository root:
#   java -jar target/MutationTester-1.0-SNAPSHOT-jar-with-dependencies.jar samples/CSProject configs/samples/csharp-statements.config
source_code_directory=src/CSProject
custom_mutation_spec=specs/StatementMutation.spec
compile_command=dotnet build tests/CSProject.Tests/CSProject.Tests.csproj
test_command=dotnet test --no-build tests/CSProject.Tests/CSProject.Tests.csproj
