# Used by samples/JSProject/run-manual-testing.bat: each mutant opens the
# browser test page for a person to check.
# Run from the repository root:
#   java -jar target/MutationTester-1.0-SNAPSHOT-jar-with-dependencies.jar samples/JSProject configs/samples/javascript-manual.config
source_code_directory=src
custom_mutation_spec=specs/OperatorMutations.spec
compile_command=echo "No compilation"
test_command=start browser-tests\test-runner.html && timeout /t 3 && exit 0
